<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- SODOO Logo Component - Using text-based logo -->
    <t t-name="point_of_sale.OdooLogo">
        <div t-attf-class="{{ props.class }}" t-attf-style="{{ props.style }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 311 120">
                <g transform="translate(10,0)">
                    <text x="0" y="90" font-family="Arial Black, Arial, sans-serif" font-size="80" font-weight="900"
                        t-attf-fill="{{ props.monochrome ? '#FFF' : '#DD4814' }}">SO</text>
                    <text x="125" y="90" font-family="Arial Black, Arial, sans-serif" font-size="80" font-weight="900"
                        t-attf-fill="{{ props.monochrome ? '#FFF' : '#7F7F7F' }}">&gt;</text>
                    <text x="177" y="90" font-family="Arial Black, Arial, sans-serif" font-size="80" font-weight="900"
                        t-attf-fill="{{ props.monochrome ? '#FFF' : '#DD4814' }}">OO</text>
                </g>
            </svg>
        </div>
    </t>
</templates>
